exports[`stylesheet snapshot 1`] = `
":root {\\n  --keepsake-paper: #FBF6EE;\\n  --keepsake-sheet: #FFFDF8;\\n  --keepsake-ink: #33302A;\\n  --keepsake-meta: #8B8375;\\n  --keepsake-rule-strong: #33302A;\\n  --keepsake-rule-thin: #E9DFCD;\\n  --keepsake-chip-border: #E5D9C4;\\n  --keepsake-accent: #C96F4A;\\n  --keepsake-accent-ink: #8A5A3D;\\n  --keepsake-accent-soft: #E8A582;\\n  --keepsake-accent-wash: #FDF1E7;\\n  --keepsake-accent-wash-ink: #A5775C;\\n  --keepsake-danger: #B4552E;\\n  --keepsake-danger-ink: #8A4526;\\n  --keepsake-danger-soft: #E07B52;\\n  --keepsake-danger-wash: #F3DDD4;\\n  --keepsake-sleep-band: #EEF2E8;\\n  --keepsake-sleep-ink: #55694E;\\n  --keepsake-accent-chip-bg: #F3E3D3;\\n  --keepsake-accent-chip-border: #D8B794;\\n  --keepsake-accent-chip-fg: #8A5A3D;\\n  --keepsake-safe-chip-bg: #D9E4D0;\\n  --keepsake-safe-chip-border: #A9C19D;\\n  --keepsake-safe-chip-fg: #4C6A43;\\n  --keepsake-tracker-feed-bg: #F6E3C2;\\n  --keepsake-tracker-feed-fg: #A4741F;\\n  --keepsake-tracker-diaper-bg: #DCEBF2;\\n  --keepsake-tracker-diaper-fg: #4A7B96;\\n  --keepsake-tracker-sleep-bg: #DCEBF2;\\n  --keepsake-tracker-sleep-fg: #4A7B96;\\n  --keepsake-tracker-meal-bg: #D9E4D0;\\n  --keepsake-tracker-meal-fg: #55694E;\\n  --keepsake-tracker-introduction-bg: #D9E4D0;\\n  --keepsake-tracker-introduction-fg: #55694E;\\n  --keepsake-tracker-medical-bg: #EEDDE8;\\n  --keepsake-tracker-medical-fg: #9A5C80;\\n  --keepsake-tracker-reaction-bg: #F3DDD4;\\n  --keepsake-tracker-reaction-fg: #B4552E;\\n  --keepsake-tracker-growth-bg: #DCEBF2;\\n  --keepsake-tracker-growth-fg: #4A7B96;\\n  --keepsake-status-safe-bg: #E3EDDC;\\n  --keepsake-status-safe-border: #A9C19D;\\n  --keepsake-status-safe-fg: #4C6A43;\\n  --keepsake-status-trying-bg: #FDF1E7;\\n  --keepsake-status-trying-border: #D8B794;\\n  --keepsake-status-trying-fg: #C96F4A;\\n  --keepsake-status-untried-bg: #EFE9DC;\\n  --keepsake-status-untried-border: #D8D0BD;\\n  --keepsake-status-untried-fg: #6F675A;\\n  --keepsake-status-avoid-bg: #F3DDD4;\\n  --keepsake-status-avoid-border: #CF9B85;\\n  --keepsake-status-avoid-fg: #B4552E;\\n}\\n\\n[data-theme=\\"night\\"] {\\n  --keepsake-paper: #24211C;\\n  --keepsake-sheet: #2B2721;\\n  --keepsake-ink: #F0E9DA;\\n  --keepsake-meta: #9A917E;\\n  --keepsake-rule-strong: #F0E9DA;\\n  --keepsake-rule-thin: #3D382F;\\n  --keepsake-chip-border: #4A4438;\\n  --keepsake-accent: #E8A582;\\n  --keepsake-accent-ink: #D9B598;\\n  --keepsake-accent-soft: #E8A582;\\n  --keepsake-accent-wash: #332418;\\n  --keepsake-accent-wash-ink: #B08A6F;\\n  --keepsake-danger: #E07B52;\\n  --keepsake-danger-ink: #E07B52;\\n  --keepsake-danger-soft: #E07B52;\\n  --keepsake-danger-wash: #332418;\\n  --keepsake-sleep-band: #2E2A22;\\n  --keepsake-sleep-ink: #A9B39B;\\n  --keepsake-accent-chip-bg: #453526;\\n  --keepsake-accent-chip-border: #6B4A38;\\n  --keepsake-accent-chip-fg: #D9B598;\\n  --keepsake-safe-chip-bg: #3F4A37;\\n  --keepsake-safe-chip-border: #6B7A58;\\n  --keepsake-safe-chip-fg: #C8D4B8;\\n  --keepsake-tracker-feed-bg: #3D3626;\\n  --keepsake-tracker-feed-fg: #E0C98F;\\n  --keepsake-tracker-diaper-bg: #2C3A40;\\n  --keepsake-tracker-diaper-fg: #8FB8CC;\\n  --keepsake-tracker-sleep-bg: #2C3A40;\\n  --keepsake-tracker-sleep-fg: #8FB8CC;\\n  --keepsake-tracker-meal-bg: #333A2C;\\n  --keepsake-tracker-meal-fg: #A9B39B;\\n  --keepsake-tracker-introduction-bg: #333A2C;\\n  --keepsake-tracker-introduction-fg: #A9B39B;\\n  --keepsake-tracker-medical-bg: #3D3238;\\n  --keepsake-tracker-medical-fg: #C49AB4;\\n  --keepsake-tracker-reaction-bg: #332418;\\n  --keepsake-tracker-reaction-fg: #E07B52;\\n  --keepsake-tracker-growth-bg: #2C3A40;\\n  --keepsake-tracker-growth-fg: #8FB8CC;\\n  --keepsake-status-safe-bg: #3F4A37;\\n  --keepsake-status-safe-border: #6B7A58;\\n  --keepsake-status-safe-fg: #C8D4B8;\\n  --keepsake-status-trying-bg: #332418;\\n  --keepsake-status-trying-border: #6B4A38;\\n  --keepsake-status-trying-fg: #E8A582;\\n  --keepsake-status-untried-bg: #2B2721;\\n  --keepsake-status-untried-border: #4A4438;\\n  --keepsake-status-untried-fg: #9A917E;\\n  --keepsake-status-avoid-bg: #332418;\\n  --keepsake-status-avoid-border: #6B4A38;\\n  --keepsake-status-avoid-fg: #E07B52;\\n}\\n\\n:root {\\n  --keepsake-font-serif: \\"Iowan Old Style\\", Palatino, \\"Palatino Linotype\\", ui-serif, Georgia, serif;\\n  --keepsake-font-sans: \\"Avenir Next\\", Avenir, \\"Segoe UI\\", Roboto, sans-serif;\\n}\\n\\n.keepsake-icon-disc {\\n  display: inline-grid;\\n  place-items: center;\\n  border-radius: 50%;\\n  background: var(--keepsake-disc-bg, var(--keepsake-rule-thin));\\n  color: var(--keepsake-disc-fg, var(--keepsake-meta));\\n}\\n\\n.keepsake-status-pill {\\n  display: inline-block;\\n  border-radius: 999px;\\n  border: 1px solid var(--keepsake-status-border);\\n  background: var(--keepsake-status-bg);\\n  color: var(--keepsake-status-fg);\\n}\\n\\n.keepsake-tracker-feed {\\n  --keepsake-disc-bg: var(--keepsake-tracker-feed-bg);\\n  --keepsake-disc-fg: var(--keepsake-tracker-feed-fg);\\n}\\n\\n.keepsake-tracker-diaper {\\n  --keepsake-disc-bg: var(--keepsake-tracker-diaper-bg);\\n  --keepsake-disc-fg: var(--keepsake-tracker-diaper-fg);\\n}\\n\\n.keepsake-tracker-sleep {\\n  --keepsake-disc-bg: var(--keepsake-tracker-sleep-bg);\\n  --keepsake-disc-fg: var(--keepsake-tracker-sleep-fg);\\n}\\n\\n.keepsake-tracker-meal {\\n  --keepsake-disc-bg: var(--keepsake-tracker-meal-bg);\\n  --keepsake-disc-fg: var(--keepsake-tracker-meal-fg);\\n}\\n\\n.keepsake-tracker-introduction {\\n  --keepsake-disc-bg: var(--keepsake-tracker-introduction-bg);\\n  --keepsake-disc-fg: var(--keepsake-tracker-introduction-fg);\\n}\\n\\n.keepsake-tracker-medical {\\n  --keepsake-disc-bg: var(--keepsake-tracker-medical-bg);\\n  --keepsake-disc-fg: var(--keepsake-tracker-medical-fg);\\n}\\n\\n.keepsake-tracker-reaction {\\n  --keepsake-disc-bg: var(--keepsake-tracker-reaction-bg);\\n  --keepsake-disc-fg: var(--keepsake-tracker-reaction-fg);\\n}\\n\\n.keepsake-tracker-growth {\\n  --keepsake-disc-bg: var(--keepsake-tracker-growth-bg);\\n  --keepsake-disc-fg: var(--keepsake-tracker-growth-fg);\\n}\\n\\n.keepsake-status-safe {\\n  --keepsake-status-bg: var(--keepsake-status-safe-bg);\\n  --keepsake-status-border: var(--keepsake-status-safe-border);\\n  --keepsake-status-fg: var(--keepsake-status-safe-fg);\\n}\\n\\n.keepsake-status-trying {\\n  --keepsake-status-bg: var(--keepsake-status-trying-bg);\\n  --keepsake-status-border: var(--keepsake-status-trying-border);\\n  --keepsake-status-fg: var(--keepsake-status-trying-fg);\\n}\\n\\n.keepsake-status-untried {\\n  --keepsake-status-bg: var(--keepsake-status-untried-bg);\\n  --keepsake-status-border: var(--keepsake-status-untried-border);\\n  --keepsake-status-fg: var(--keepsake-status-untried-fg);\\n}\\n\\n.keepsake-status-avoid {\\n  --keepsake-status-bg: var(--keepsake-status-avoid-bg);\\n  --keepsake-status-border: var(--keepsake-status-avoid-border);\\n  --keepsake-status-fg: var(--keepsake-status-avoid-fg);\\n}\\n"
`;
