{
  "private": true,
  "workspaces": [
    "app",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "prepare": "husky",
    "check:secrets": "gitleaks git --pre-commit --staged --redact --no-banner",
    "check:security:dependencies": "node scripts/audit-dependencies.mjs",
    "check:dependencies": "node scripts/check-dependencies.ts",
    "lint:boundaries": "depcruise packages app/src",
    "test": "node --test packages/*/tests/*.test.ts tests/*.test.ts tests/*.test.mjs",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "start": "npm run start --workspace app"
  },
  "dependencies": {
    "babel-preset-expo": "~54.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "ui-ux-pro-max-cli": "^2.15.0"
  },
  "type": "module",
  "overrides": {
    "query-string": {
      "decode-uri-component": "file:./packages/query-decoder-compat"
    },
    "postcss": "8.5.31",
    "xcode": {
      "uuid": "11.1.1"
    },
    "metro": {
      "image-size": "file:./packages/metro-image-size-compat"
    }
  }
}
